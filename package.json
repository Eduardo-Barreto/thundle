{
  "scripts": {
    "dev": "portless run vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt src/ index.html vite.config.ts tsconfig.json package.json",
    "fmt:check": "oxfmt --check src/ index.html vite.config.ts tsconfig.json package.json",
    "knip": "knip",
    "doctor": "react-doctor . --verbose",
    "test": "bun test",
    "test:e2e": "playwright test",
    "verify": "bun run lint && bun run fmt:check && bun run knip && bun run build && bun run test && bun run doctor",
    "prepare": "husky"
  },
  "dependencies": {
    "fuzzysort": "^3.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "knip": "^6.7.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react-doctor": "^0.2.8",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md,css,yaml}": [
      "oxfmt --write"
    ]
  }
}
